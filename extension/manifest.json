{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "__MSG_actionTitle__", "default_popup": "action.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["translations.js", "i18n.js", "core.js", "popup-style.js", "content.js"], "run_at": "document_idle" },
    { "matches": ["https://tactiq.io/tools/run/youtube_transcript*"], "js": ["core.js", "tactiq.js"], "run_at": "document_idle" }
  ]
}
