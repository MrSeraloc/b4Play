# Opcional: configure aqui OU diretamente nas opções da extensão.
# Valores salvos nas opções têm prioridade e ficam em data/ai-config.json.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Em branco para modelos sem suporte ao parâmetro reasoning.
OPENAI_BASE_URL=https://api.openai.com/v1
# Para OpenRouter, troque AI_PROVIDER para openrouter e preencha:
OPENROUTER_API_KEY=
# Use o ID exato do catálogo do OpenRouter, com o prefixo do provedor.
OPENROUTER_MODEL=
# Em branco usa o padrão do modelo; só informe low/none/etc. se suportado.
OPENROUTER_REASONING_EFFORT=
# O serviço gera seu próprio token em data/service-token.txt.
# Este token local é o que deve ser colocado nas opções da extensão.
