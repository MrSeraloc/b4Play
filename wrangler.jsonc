{
  "name": "b4play",
  "main": "service/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {"name": "RATE_LIMIT", "namespace_id": "1", "simple": {"limit": 6, "period": 60}},
    {"name": "SERVICE_LIMIT", "namespace_id": "2", "simple": {"limit": 30, "period": 60}}
  ]
}
